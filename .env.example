# ─────────────────────────────────────────────────────────────
# Ring Lot Morong — environment configuration
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Canonical origin used for metadata, sitemap, JSON-LD and OG images.
# OWNER MUST CONFIRM the domain before launch (see docs/LAUNCH-CHECKLIST.md).
NEXT_PUBLIC_SITE_URL=https://ringlotmorong.com

# "production" enables indexing. Anything else (preview, staging, development)
# serves robots.txt Disallow + X-Robots-Tag: noindex. Vercel's VERCEL_ENV is also honoured.
SITE_ENV=development

# ── Lead delivery (server-only). Configure at least one for the contact form to deliver.
# Resend (https://resend.com) — transactional email via REST, no SDK dependency.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=
# Send the visitor a confirmation email (true/false). Keep false until the sending domain is verified.
LEAD_SEND_CONFIRMATION=false
# Generic JSON webhook (Slack/Make/Zapier/CRM). Receives the structured lead record.
LEAD_WEBHOOK_URL=

# ── Analytics (optional, privacy-friendly). Leave empty to disable all third-party scripts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ── Search engine notifications (optional). IndexNow key (8–128 hex chars).
INDEXNOW_KEY=

# ── Preview environments only: allow the site to be embedded in an iframe (e.g. sandbox preview).
ALLOW_EMBEDDING=false
